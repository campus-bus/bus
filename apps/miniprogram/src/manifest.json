{
    "name" : "环线坐车",
    "appid" : "",
    "description" : "校园环线公交车时刻表查询与到站预测",
    "versionName" : "1.0.0",
    "versionCode" : "100",
    "transformPx" : false,
    /* 小程序特有相关 */
    "mp-weixin" : {
        "appid" : "wx9793b294a259ec3a",
        "setting" : {
            "urlCheck" : false,
            "es6" : true,
            "minified" : true
        },
        "usingComponents" : true,
        "lazyCodeLoading" : "requiredComponents",
        /* 2022-07-14 后发布的小程序必须声明才会放行定位接口，
           否则真机/体验版调用 getLocation、startLocationUpdate、onLocationChange 会直接失败 */
        "requiredPrivateInfos" : [ "getLocation", "startLocationUpdate", "onLocationChange" ],
        "permission" : {
            "scope.userLocation" : {
                "desc" : "用于推荐附近站点和显示你的位置"
            }
        }
    },
    "uniStatistics": {  
        "enable": false
    },
    "vueVersion" : "3"
}
